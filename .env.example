# Server Port
SERVER_PORT=3000

# DB Connection Information
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wku_ai_chat

# [Cloud] Aiven DB SSL 강제 방지를 위해 로컬 개발은 false, Vercel 배포만 true로 설정
DB_SSL=false

# [Cloud] Aiven DB SSL CA 인증서(DB_SSL=true 설정 시 필수 입력)
# 형식 예시: DB_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# 가짜 인증서 구문 오류를 빨리 찾기 위해 example 값은 완전히 비워둠
DB_CA=

# AI API Key
AI_API_KEY=your_ai_api_key_here

# Session Secret
SESSION_SECRET=your_session_secret_here
