# Server Port
SERVER_PORT=3000

# DB Connection Information
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wku_ai_chat

# [Cloud] 로컬 개발/운영 환경 모두 기본값 false. 운영 DB(Railway MySQL)는 같은 프로젝트 내부망(private network)으로
# 접속하므로 SSL이 필요 없습니다. SSL이 필요한 DB(공개 엔드포인트 등)에 접속할 때만 true로 설정하세요.
DB_SSL=false

# [Cloud] DB_SSL=true로 설정했을 때만 필요한 CA 인증서 (현재 Railway 내부망 연결에서는 사용하지 않음)
# 형식 예시: DB_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# 가짜 인증서 구문 오류를 빨리 찾기 위해 example 값은 완전히 비워둠
DB_CA=

# AI API Key (Anthropic, Claude Haiku 4.5 — 챗봇 응답 생성)
AI_API_KEY=your_ai_api_key_here

# Voyage AI API Key (임베딩 — Claude 자체엔 임베딩 API가 없어 Anthropic 공식 추천 파트너사 사용)
VOYAGE_API_KEY=your_voyage_api_key_here

# Session Secret
SESSION_SECRET=your_session_secret_here

# [Cloud] 배포 환경에서 CORS 허용 origin (프론트엔드 도메인, 예: https://your-app.vercel.app)
# 로컬 개발은 비워두면 기존과 동일하게 모든 origin 허용
CLIENT_ORIGIN=

# Google OAuth (로그인) — Google Cloud Console에서 발급.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth 콜백/로그인 완료 후 돌아갈 프론트 주소. 반드시 "브라우저가 실제로 보는" 도메인이어야
# 함 — client/vercel.json(운영)과 client/vite.config.js(로컬)가 /api/*를 백엔드로 프록시하므로,
# Google에 등록하는 리디렉션 URI도 이 값 기준 경로(`${OAUTH_CALLBACK_BASE_URL}/api/auth/google/callback`)여야
# 세션 쿠키가 올바른 도메인에 스코프된다. 백엔드(Railway) 원본 도메인을 직접 쓰면 안 됨.
# 로컬: http://localhost:5173   운영: https://<실제 Vercel 도메인>
OAUTH_CALLBACK_BASE_URL=http://localhost:5173
